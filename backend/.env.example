# Copia este archivo como ".env" (mismo nivel que build.gradle) y reemplaza los valores
# con tus credenciales reales de Supabase. El archivo ".env" NUNCA debe subirse a git
# (ya está en .gitignore) porque tiene tu contraseña.

SPRING_DATASOURCE_URL=jdbc:postgresql://TU-HOST-DE-SUPABASE:5432/postgres
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=tu_password_de_supabase

# Opcionales (si no los defines, se usan los valores por defecto que ya están en application.properties)
# APP_CORS_ALLOWED_ORIGINS=http://localhost:5173
# SPRINGDOC_SWAGGER_UI_ENABLED=true
# SPRINGDOC_API_DOCS_ENABLED=true
JWT_SECRET=cambia_esto_por_una_cadena_aleatoria_de_al_menos_32_caracteres